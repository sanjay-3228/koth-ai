# ==============================================================================
# PWNGROUNDS CONFIGURATION PROFILE: WI-FI / LAN-ONLY KOTH
# ==============================================================================
# Use this configuration when the competition is conducted entirely over a local
# Wi-Fi or LAN subnet without an organizer VPN tunnel.
#
# Replace the placeholder values with the organizer-provided information.
# ==============================================================================

# NVIDIA NIM Model Configuration
NVIDIA_API_KEY=your-nvidia-api-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_FAST_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_REASONING_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_CONFIDENCE_THRESHOLD=0.75

# Operational Mode (Always keep DRY_RUN and OBSERVATION_ONLY=true until explicitly verified)
KOTH_MODE=DRY_RUN
OBSERVATION_ONLY=true
KILL_SWITCH=false
MAX_ACTIONS_PER_MINUTE=12

# PwnGrounds Network Mode
# Options: auto, wifi_only, wifi_plus_vpn, vpn_only
PWN_MODE=wifi_only

# Competition CIDRs (Comma-separated list of authorized competition subnets)
# Example: organizer assigns 192.168.100.0/24 as the KOTH subnet
PWN_COMPETITION_CIDRS=192.168.100.0/24

# Own Infrastructure (Your assigned host IP and monitored services)
# Format: <host>:<port>:<optional_systemd_unit>
PWN_OWN_HOSTS=192.168.100.25
PWN_OWN_SERVICES=192.168.100.25:80:nginx,192.168.100.25:22:sshd

# Authorized Competition Target Hosts (Comma-separated IPs)
# The agent will strictly refuse to attack or scan any IP outside this list.
PWN_TARGET_HOSTS=192.168.100.10,192.168.100.11,192.168.100.12

# PwnGrounds Competition Scoreboard Endpoint
PWN_SCOREBOARD_URL=http://192.168.100.1:8080/api/scoreboard
SCOREBOARD_POLL_SECONDS=15
STALE_TELEMETRY_THRESHOLD=60.0

# Persistence & Logging
DB_PATH=koth_agent.db
LOG_LEVEL=INFO
