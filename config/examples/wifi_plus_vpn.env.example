# ==============================================================================
# PWNGROUNDS CONFIGURATION PROFILE: WI-FI + ORGANIZER VPN KOTH
# ==============================================================================
# Use this configuration when connected to a local Wi-Fi/LAN for general access
# and simultaneously connected to the competition network via an organizer VPN
# (e.g., OpenVPN tun0, WireGuard wg0).
#
# Replace the placeholder values with the organizer-provided information.
# ==============================================================================

# NVIDIA NIM Model Configuration
NVIDIA_API_KEY=your-nvidia-api-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_FAST_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_REASONING_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_CONFIDENCE_THRESHOLD=0.75

# Operational Mode (Always keep DRY_RUN and OBSERVATION_ONLY=true until explicitly verified)
KOTH_MODE=DRY_RUN
OBSERVATION_ONLY=true
KILL_SWITCH=false
MAX_ACTIONS_PER_MINUTE=12

# PwnGrounds Network Mode
# Options: auto, wifi_only, wifi_plus_vpn, vpn_only
PWN_MODE=wifi_plus_vpn

# Competition CIDRs (Subnets accessible exclusively through the VPN tunnel)
# Example: 10.100.0.0/16
PWN_COMPETITION_CIDRS=10.100.0.0/16

# Own Infrastructure (Your assigned VPN tunnel IP and monitored services)
# Format: <host>:<port>:<optional_systemd_unit>
PWN_OWN_HOSTS=10.100.1.42
PWN_OWN_SERVICES=10.100.1.42:80:nginx,10.100.1.42:3306:mariadb

# Authorized Competition Target Hosts (Target IPs inside the VPN CIDR)
# The agent will strictly refuse to attack or scan any IP outside this list.
PWN_TARGET_HOSTS=10.100.2.10,10.100.2.11,10.100.3.5

# PwnGrounds Competition Scoreboard Endpoint (accessible via VPN or local Wi-Fi)
PWN_SCOREBOARD_URL=http://10.100.0.1/api/scoreboard
SCOREBOARD_POLL_SECONDS=15
STALE_TELEMETRY_THRESHOLD=60.0

# Persistence & Logging
DB_PATH=koth_agent.db
LOG_LEVEL=INFO
