# ==============================================================================
# KOTH COMMAND / SWARM COORDINATOR - PRODUCTION CONFIGURATION
# ==============================================================================
# Copy this file to .env or set environment variables in your deployment shell.
# These environment variables configure the KOTH Swarm authoritative coordinator.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NETWORK & TRANSPORT
# ------------------------------------------------------------------------------
# Bind address: 127.0.0.1 for local single-machine rehearsal; 0.0.0.0 for LAN/competition
SWARM_HOST=0.0.0.0
SWARM_PORT=5000

# Transport Security (TLS)
# Set to true to enforce HTTPS between agents and coordinator
SWARM_USE_TLS=false
SWARM_SSL_CERT=
SWARM_SSL_KEY=

# ------------------------------------------------------------------------------
# 2. RUNTIME PROFILE
# ------------------------------------------------------------------------------
# Profile options:
#   LOCAL_REHEARSAL   : Local testbed, allows username registration/login
#   LAN_REHEARSAL     : Dedicated team LAN with strict token authorization
#   RADMIN_REHEARSAL  : Virtual LAN (Radmin VPN / WireGuard)
#   PWNGROUNDS_SIM    : Simulation mode against standard competition topologies
#   DEV               : Development and debugging mode
SWARM_PROFILE=LAN_REHEARSAL

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY TOKENS
# ------------------------------------------------------------------------------
# Shared team secret token required for worker-to-coordinator registration
SWARM_AUTH_TOKEN=koth-swarm-prod-secret-key-change-me

# Privileged operator token for phase transitions, kill switch, and emergency stops
SWARM_OPERATOR_TOKEN=koth-operator-admin-token-change-me

# Authoritative agent roster (comma-separated agent IDs)
SWARM_AUTHORIZED_AGENTS=agent-01,agent-02,agent-03,agent-04

# Human operator mapping to agent seats
# Format: agent-id:username,agent-id:username,...
SWARM_AGENT_USERNAMES=agent-01:leader,agent-02:attacker1,agent-03:attacker2,agent-04:defender

# Independent per-agent authentication tokens (optional, recommended for LAN competitions)
# Format: agent-01:token1,agent-02:token2,agent-03:token3,agent-04:token4
SWARM_AGENT_TOKENS=

# Administrator account username for coordinator administration
SWARM_ADMIN_USERNAME=admin

# Enable username-only authentication bypass (ONLY for LOCAL_REHEARSAL; keep false in LAN)
SWARM_ENABLE_USERNAME_LOGIN=false

# ------------------------------------------------------------------------------
# 4. TIMING & ENGINE PARAMETERS
# ------------------------------------------------------------------------------
# Task lease Time-To-Live in seconds (tasks automatically released if unrenewed)
SWARM_LEASE_TTL=15.0

# Agent heartbeat timeout in seconds (marked stale/offline if missed)
SWARM_HEARTBEAT_TIMEOUT=10.0

# Background engine maintenance and lease reaper interval in seconds
SWARM_MAINTENANCE_INTERVAL=1.0

# ------------------------------------------------------------------------------
# 5. PERSISTENT STORAGE
# ------------------------------------------------------------------------------
# Path to SQLite database file. By default on Windows, Electron places this at:
# %APPDATA%\KOTH Command\koth_swarm.db
# When running standalone coordinator, specify absolute path here:
SWARM_DB_PATH=C:\ProgramData\KOTH-Command\koth_swarm.db

# ------------------------------------------------------------------------------
# 6. EXTERNAL LLM PROVIDERS (PER-AGENT DEPLOYMENT)
# ------------------------------------------------------------------------------
# Note: Per-agent LLM credentials should be configured securely via the KOTH Command
# Desktop interface or stored encrypted in the agent database.
# Supported providers: openai, anthropic, gemini, custom
# LLM features are optional; the swarm operates with deterministic offensive/defensive logic.

