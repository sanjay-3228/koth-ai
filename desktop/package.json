{
  "name": "koth-command",
  "productName": "KOTH Command",
  "version": "1.0.0",
  "description": "KOTH Command - Enterprise Desktop Control System for King-of-the-Hill & Red vs Blue Cybersecurity Competitions",
  "author": "KOTH Swarm Operations Team",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --win --x64"
  },
  "build": {
    "appId": "com.koth.command",
    "productName": "KOTH Command",
    "copyright": "Copyright © 2026 KOTH Swarm",
    "directories": {
      "output": "../dist-installer",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend-dist/koth-coordinator.exe",
        "to": "backend/koth-coordinator.exe"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KOTH Command",
      "artifactName": "KOTH-Command-Setup.exe",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "lucide-react": "^1.64.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^28.2.0",
    "electron-builder": "^26.18.0",
    "vite": "^5.1.0"
  }
}