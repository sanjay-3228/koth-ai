# ==============================================================================
# KOTH AGENT ENVIRONMENT CONFIGURATION
# ==============================================================================

# Multi-Tier LLM Architecture Configuration
# Tier 1: Fast / Tactical - NVIDIA Nemotron
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_FAST_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
FAST_CONFIDENCE_THRESHOLD=0.75

# Tier 2: Reasoning / Escalation - Groq GPT-OSS 120B
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_REASONING_MODEL=openai/gpt-oss-120b
REASONING_CONFIDENCE_THRESHOLD=0.85

# Tier 3: Specialist / Final Escalation - OpenRouter GLM 5.3 Flash
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SPECIALIST_MODEL=z-ai/glm-5.3-flash

# Common LLM Routing Settings
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1

# Operational & Safety Controls
KOTH_MODE=DRY_RUN
DRY_RUN=true
OBSERVATION_ONLY=true
KILL_SWITCH=false
MAX_ACTIONS_PER_MINUTE=12
TICK_INTERVAL_SECONDS=10.0

# Infrastructure & Target Boundaries
OWN_SERVICES=
TARGET_HOSTS=

# Lab Environment Profile: DEV (default), LOCAL_REHEARSAL, PWNGROUNDS_SIM, LAN_REHEARSAL, RADMIN_REHEARSAL
LAB_PROFILE=DEV

# Scoreboard Ingestion
# Supply the organizer-provided scoreboard URL only for the competition environment.
SCOREBOARD_URL=
STALE_TELEMETRY_THRESHOLD=60.0

# Storage & Dashboard
DB_PATH=koth_agent.db
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5000
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 4-Agent Swarm Configuration (null_warriors)
# ------------------------------------------------------------------------------
TEAM_ID=null_warriors
AGENT_ID=agent-01
AGENT_ROLE=WORKER
SWARM_ENABLED=true

# Dynamic Network & Deployment Configuration (enter at deployment time)
COORDINATOR_LAN_IP=
COORDINATOR_BIND_HOST=
COORDINATOR_URL=
SWARM_PORT=5000

# Swarm Security & Tokens
SWARM_AUTH_TOKEN=
SWARM_OPERATOR_TOKEN=
SWARM_AGENT_TOKENS=agent-01:1000,agent-02:1001,agent-03:1002,agent-04:1003
SWARM_USE_TLS=true
SWARM_CA_CERT=certs/ca.crt
SWARM_SSL_CERT=certs/server.crt
SWARM_SSL_KEY=certs/server.key

PHASE_POLL_INTERVAL_SECONDS=3.0
HEARTBEAT_INTERVAL_SECONDS=3.0
LEASE_TTL_SECONDS=15.0
PWN_PROFILE=LAN_REHEARSAL
PROTECTED_HOSTS=
ALLOWED_PORTS=21,22,80,443,8080
ALLOWED_ACTIONS=nmap_scan,audit_local_services,patch_vulnerability,monitor_connections,exploit_service
